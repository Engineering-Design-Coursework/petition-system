# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. ".env" asla commit'lenmez.

# dev = yerel geliştirme, prod = canlı sunucu (Render)
APP_ENV=dev
# Oturum çerezini imzalar. prod'da uzun rastgele bir değer olmalı:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me
# Paylaşım linklerinde kullanılan site adresi
BASE_URL=http://127.0.0.1:8000

# --- Firebase (boş bırakılırsa uygulama DEMO MODUNDA çalışır: veriler bellekte, hazır demo kullanıcılar) ---
# Firebase Console > Proje ayarları > Genel > Web uygulaması (firebaseConfig)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Firebase Console > Proje ayarları > Hizmet hesapları > Yeni özel anahtar oluştur
# İndirilen JSON dosyasının yolu (ör. firebase-key.json) ya da JSON metninin tamamı (Render için)
FIREBASE_CREDENTIALS=
